#!/bin/bash
# A push to a public repository is publication, so personal data is stopped
# here as a second line of defence after pre-commit.

set -uo pipefail
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UNBORN=0000000000000000000000000000000000000000

status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$UNBORN" ] && continue
  if [ "$remote_sha" = "$UNBORN" ]; then
    range=$(git merge-base origin/main "$local_sha" 2>/dev/null || git hash-object -t tree /dev/null)
  else
    range=$remote_sha
  fi
  PII_IBAN_ALLOW_SOURCE=$(git show "$local_sha:.githooks/pii-iban-allow" 2>/dev/null || true)
  PII_IDCODE_ALLOW_SOURCE=$(git show "$local_sha:.githooks/pii-idcode-allow" 2>/dev/null || true)
  export PII_IBAN_ALLOW_SOURCE PII_IDCODE_ALLOW_SOURCE
  if ! git diff "$range" "$local_sha" | "$HOOK_DIR/pii-scan"; then
    status=1
  fi
  if git diff --name-only "$range" "$local_sha" | grep -qE '^docs/inputs/'; then
    echo "🛑 Push contains files under docs/inputs/ (private)."
    status=1
  fi
done
exit $status
