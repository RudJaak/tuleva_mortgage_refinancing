# Copy to .env (gitignored) and fill in. The backend imports it on startup.
# Every integration has an offline stub, so the app runs with these defaults.

# true | false. Greets people by the name in the public eID certificate directories
DEMO_NAME_LOOKUP=true
# stub | claude
EXTRACTION_MODE=stub
ANTHROPIC_API_KEY=

# false | true. true rejects documents that aren't sealed by a known bank
REQUIRE_BANK_SEAL=false

# true | false. Seeds ~520 synthetic commitments (~€60M) on startup if the pool is empty
DEMO_SEED=true
